# Paraiso Ala Eh - Supabase/PostgreSQL example
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false
FLASK_DEBUG=0
SECRET_KEY=change-this-secret-key
AUTO_INIT_DB=true

# Required for Supabase/Render:
# Copy the PostgreSQL connection string from Supabase > Project Settings > Database.
# Example only; replace the values with your actual Supabase details.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
DB_SSLMODE=require
DB_CREATE_IF_MISSING=false

# Optional local PostgreSQL fallback if DATABASE_URL is not set:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your-local-password
# DB_NAME=paraiso_ala_eh_db
